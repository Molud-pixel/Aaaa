local function Notify(text)
    if not Config.Notifications then return end
    local notif = Create("TextLabel", {Parent = NotifContainer, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Themes[Config.Theme].TopBar, TextColor3 = Themes[Config.Theme].Text, Text = " " .. text, Font = Enum.Font.GothamSemibold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, TextTransparency = 1})
    Create("UICorner", {Parent = notif, CornerRadius = UDim.new(0, 5)})
    Create("UIStroke", {Parent = notif, Color = Themes[Config.Theme].Accent, Thickness = 1})
    
    Tween(notif, {BackgroundTransparency = 0.2, TextTransparency = 0, Position = UDim2.new(0,0,0,0)}, 0.3)
    task.delay(3, function()
        Tween(notif, {BackgroundTransparency = 1, TextTransparency = 1, Position = UDim2.new(1,0,0,0)}, 0.3)
        task.wait(0.3)
        notif:Destroy()
    end)
end


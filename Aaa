-- IDs R15 cl谩sicos de Roblox para caminar/correr y saltar.
-- Se cargan mediante Animator para que sean animaciones reales.
local WALK_ANIMATION_ID = "rbxassetid://507777826"
local RUN_ANIMATION_ID  = "rbxassetid://507767714"
local JUMP_ANIMATION_ID = "rbxassetid://507765000"

local function stopTrack(track)
	if track then
		track:Stop(0.15)
	end
end

local function loadAnimationTrack(animationId, priority, looped)
	if not humanoid then return nil end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	local animation = Instance.new("Animation")
	animation.AnimationId = animationId

	local ok, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)

	if not ok or not track then
		warn("No se pudo cargar la animaci贸n: " .. animationId)
		return nil
	end

	track.Priority = priority
	track.Looped = looped
	return track
end

local function setupRealAnimations()
	stopTrack(sprintTrack)
	stopTrack(jumpTrack)
	sprintTrack = nil
	jumpTrack = nil

	if sprintEnabled and humanoid then
		sprintTrack = loadAnimationTrack(RUN_ANIMATION_ID, Enum.AnimationPriority.Movement, true)
	end

	if jumpAnimEnabled and humanoid then
		jumpTrack = loadAnimationTrack(JUMP_ANIMATION_ID, Enum.AnimationPriority.Action, false)
	end
end

local function createRainbowTrail()
	if not character then return end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	if trail then
		trail:Destroy()
		trail = nil
	end

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 1.2, 0)
	a0.Parent = root

	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -1.2, 0)
	a1.Parent = root

	trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.45
	trail.MinLength = 0.05
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05),
		NumberSequenceKeypoint.new(1, 1)
	})
	trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.85),
		NumberSequenceKeypoint.new(1, 0)
	})
	trail.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, Color3.fromHSV(0.00, 1, 1)),
		ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
		ColorSequenceKeypoint.new(0.34, Color3.fromHSV(0.34, 1, 1)),
		ColorSequenceKeypoint.new(0.51, Color3.fromHSV(0.51, 1, 1)),
		ColorSequenceKeypoint.new(0.68, Color3.fromHSV(0.68, 1, 1)),
		ColorSequenceKeypoint.new(0.85, Color3.fromHSV(0.85, 1, 1)),
		ColorSequenceKeypoint.new(1.00, Color3.fromHSV(1.00, 1, 1)),
	})
	trail.Parent = root
end

local function setRainbowTrail(enabled)
	rainbowTrailEnabled = enabled
	if enabled then
		createRainbowTrail()
	elseif trail then
		trail:Destroy()
		trail = nil
	end
end


-- Control de animaciones y Auto Sprint.
local function connectCharacterEvents()
	if not humanoid then return end

	humanoid.Running:Connect(function(speed)
		if sprintTrack then
			if sprintEnabled and speed > 1 and humanoid:GetState() ~= Enum.HumanoidStateType.Jumping then
				if not sprintTrack.IsPlaying then
					sprintTrack:Play(0.15, 1, 1.05)
				end
				sprintTrack:AdjustSpeed(math.clamp(speed / 16, 0.75, 2.2))
			else
				stopTrack(sprintTrack)
			end
		end

		if autoSprintEnabled then
			if speed > 1 then
				humanoid.WalkSpeed = math.max(currentSpeed, 24)
			else
				humanoid.WalkSpeed = currentSpeed
			end
		end
	end)

	humanoid.StateChanged:Connect(function(_, newState)
		if jumpAnimEnabled and jumpTrack and newState == Enum.HumanoidStateType.Jumping then
			jumpTrack:Play(0.08, 1, 1)
		elseif newState == Enum.HumanoidStateType.Landed then
			stopTrack(jumpTrack)
		end
	end)
end


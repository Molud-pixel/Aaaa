local function AddCategory(name)
    local tabBtn = Create("TextButton", {Parent = CategoryList, Size = UDim2.new(1, 0, 0, 25), BackgroundColor3 = Themes[Config.Theme].Element, Text = name, TextColor3 = Themes[Config.Theme].Text, Font = Enum.Font.Gotham, TextSize = 12})
    Create("UICorner", {Parent = tabBtn, CornerRadius = UDim.new(0, 5)})
    
    local scrollFrame = Create("ScrollingFrame", {Parent = ContentContainer, Size = UDim2.new(1, -115, 1, -10), Position = UDim2.new(0, 110, 0, 5), BackgroundTransparency = 1, ScrollBarThickness = 3, Visible = false})
    Create("UIListLayout", {Parent = scrollFrame, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5)})
    
    tabBtn.MouseButton1Click:Connect(function()
        if ActiveTab then ActiveTab.Visible = false end
        scrollFrame.Visible = true
        ActiveTab = scrollFrame
        Tween(scrollFrame, {CanvasPosition = Vector2.new(0,0)}, 0.2)
    end)
    if not ActiveTab then ActiveTab = scrollFrame; scrollFrame.Visible = true end
    CategoryList.CanvasSize = UDim2.new(0, 0, 0, #CategoryList:GetChildren() * 30)

    local function RegisterElement(frame, elName)
        table.insert(SearchableElements, {Frame = frame, Name = elName:lower()})
    end

    local TabObj = {}
    function TabObj:AddButton(text, callback)
        local btn = Create("TextButton", {Parent = scrollFrame, Size = UDim2.new(1, -10, 0, 30), BackgroundColor3 = Themes[Config.Theme].Element, Text = text, TextColor3 = Themes[Config.Theme].Text, Font = Enum.Font.GothamSemibold, TextSize = 13})
        Create("UICorner", {Parent = btn, CornerRadius = UDim.new(0, 5)})
        btn.MouseButton1Click:Connect(function() Tween(btn, {Size = UDim2.new(1, -15, 0, 28)}, 0.1); task.wait(0.1); Tween(btn, {Size = UDim2.new(1, -10, 0, 30)}, 0.1); pcall(callback) end)
        RegisterElement(btn, text)
        scrollFrame.CanvasSize = UDim2.new(0,0,0, #scrollFrame:GetChildren() * 35)
    end
    
    function TabObj:AddToggle(text, callback)
        local frame = Create("Frame", {Parent = scrollFrame, Size = UDim2.new(1, -10, 0, 30), BackgroundColor3 = Themes[Config.Theme].Element})
        Create("UICorner", {Parent = frame, CornerRadius = UDim.new(0, 5)})
        local label = Create("TextLabel", {Parent = frame, Size = UDim2.new(0.7, 0, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = text, TextColor3 = Themes[Config.Theme].Text, Font = Enum.Font.GothamSemibold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left})
        local btn = Create("TextButton", {Parent = frame, Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -50, 0.5, -10), BackgroundColor3 = Color3.fromRGB(100, 100, 100), Text = ""})
        Create("UICorner", {Parent = btn, CornerRadius = UDim.new(1, 0)})
        local indicator = Create("Frame", {Parent = btn, Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = Color3.fromRGB(255,255,255)})
        Create("UICorner", {Parent = indicator, CornerRadius = UDim.new(1, 0)})
        
        local state = false
        btn.MouseButton1Click:Connect(function()
            state = not state
            Tween(indicator, {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}, 0.2)
            Tween(btn, {BackgroundColor3 = state and Themes[Config.Theme].Accent or Color3.fromRGB(100, 100, 100)}, 0.2)
            pcall(callback, state)
        end)
        RegisterElement(frame, text)
        scrollFrame.CanvasSize = UDim2.new(0,0,0, #scrollFrame:GetChildren() * 35)
        return function(newState) state = newState; Tween(indicator, {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}, 0.2); Tween(btn, {BackgroundColor3 = state and Themes[Config.Theme].Accent or Color3.fromRGB(100, 100, 100)}, 0.2) end
    end
    
    function TabObj:AddSlider(text, min, max, callback)
        local frame = Create("Frame", {Parent = scrollFrame, Size = UDim2.new(1, -10, 0, 40), BackgroundColor3 = Themes[Config.Theme].Element})
        Create("UICorner", {Parent = frame, CornerRadius = UDim.new(0, 5)})
        local label = Create("TextLabel", {Parent = frame, Size = UDim2.new(1, -10, 0.5, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = text, TextColor3 = Themes[Config.Theme].Text, Font = Enum.Font.GothamSemibold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left})
        local valLabel = Create("TextLabel", {Parent = frame, Size = UDim2.new(0, 30, 0.5, 0), Position = UDim2.new(1, -40, 0, 0), BackgroundTransparency = 1, Text = tostring(min), TextColor3 = Themes[Config.Theme].Accent, Font = Enum.Font.GothamBold, TextSize = 12})
        local bar = Create("TextButton", {Parent = frame, Size = UDim2.new(1, -20, 0, 5), Position = UDim2.new(0, 10, 0.7, 0), BackgroundColor3 = Color3.fromRGB(100, 100, 100), Text = ""})
        local fill = Create("Frame", {Parent = bar, Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Themes[Config.Theme].Accent})
        
        local dragging = false
        local function Update(input)
            local pos = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + (max - min) * pos)
            fill.Size = UDim2.new(pos, 0, 1, 0)
            valLabel.Text = tostring(val)
            pcall(callback, val)
        end
        bar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; Update(input) end end)
        UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
        UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then Update(input) end end)
        RegisterElement(frame, text)
        scrollFrame.CanvasSize = UDim2.new(0,0,0, #scrollFrame:GetChildren() * 45)
    end
    
    function TabObj:AddInput(text, callback)
        local frame = Create("Frame", {Parent = scrollFrame, Size = UDim2.new(1, -10, 0, 30), BackgroundColor3 = Themes[Config.Theme].Element})
        Create("UICorner", {Parent = frame, CornerRadius = UDim.new(0, 5)})
        local label = Create("TextLabel", {Parent = frame, Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = text, TextColor3 = Themes[Config.Theme].Text, Font = Enum.Font.GothamSemibold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left})
        local box = Create("TextBox", {Parent = frame, Size = UDim2.new(0.4, 0, 0, 20), Position = UDim2.new(0.6, -10, 0.5, -10), BackgroundColor3 = Themes[Config.Theme].Background, TextColor3 = Themes[Config.Theme].Text, Text = "", PlaceholderText = "Input...", Font = Enum.Font.Gotham, TextSize = 12, ClearTextOnFocus = false})
        Create("UICorner", {Parent = box, CornerRadius = UDim.new(0, 3)})
        box.FocusLost:Connect(function() pcall(callback, box.Text) end)
        RegisterElement(frame, text)
        scrollFrame.CanvasSize = UDim2.new(0,0,0, #scrollFrame:GetChildren() * 35)
    end

    function TabObj:AddLabel(text)
        local lbl = Create("TextLabel", {Parent = scrollFrame, Size = UDim2.new(1, -10, 0, 20), BackgroundTransparency = 1, Text = text, TextColor3 = Themes[Config.Theme].Accent, Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center})
        RegisterElement(lbl, text)
        scrollFrame.CanvasSize = UDim2.new(0,0,0, #scrollFrame:GetChildren() * 25)
        return lbl
    end

    return TabObj
end

